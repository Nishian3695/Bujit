<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no Google cloud backup or device-to-device copy of Bujit's data.
     The database's key lives in the Android Keystore, which never leaves the
     device, so a copied database couldn't be opened on the new phone anyway.
     Moving to a new phone uses Bujit's own encrypted backup (Settings). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
