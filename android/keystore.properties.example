# Copy to android/keystore.properties (never committed) to sign release builds
# locally with the same keystore as the Java app. In CI these come from the
# STORE_FILE / STORE_PASSWORD / KEY_ALIAS / KEY_PASSWORD environment variables.

storeFile=/absolute/path/to/your/release.jks
storePassword=your_store_password
keyAlias=your_key_alias
keyPassword=your_key_password
