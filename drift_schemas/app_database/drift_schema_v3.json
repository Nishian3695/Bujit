    {
      "name": "expense_item_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expense_item_rows\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"amount\" REAL NOT NULL, \"start_date\" INTEGER NOT NULL, \"current_due_date\" INTEGER NOT NULL, \"end_date\" INTEGER NULL, \"frequency\" INTEGER NOT NULL, \"frequency_units\" TEXT NOT NULL, \"category\" TEXT NOT NULL DEFAULT 'Other', \"is_credit\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_credit\" IN (0, 1)), \"credit_limit\" REAL NULL, \"google_task_id\" TEXT NULL, \"remind_in_tasks\" INTEGER NOT NULL DEFAULT 1 CHECK (\"remind_in_tasks\" IN (0, 1)), \"source\" TEXT NOT NULL DEFAULT 'balance', \"source_id\" TEXT NULL, \"linked_account_id\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "income_stream_model_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"income_stream_model_rows\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"amount\" REAL NOT NULL, \"start_date\" INTEGER NOT NULL, \"frequency\" INTEGER NOT NULL, \"frequency_units\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_active\" IN (0, 1)), \"google_task_id\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "category_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"category_rows\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE);"
        }
      ]
    },
    {
      "name": "app_meta_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_meta_rows\" (\"id\" INTEGER NOT NULL DEFAULT 0 CHECK (id = 0), \"current_balance\" REAL NOT NULL DEFAULT 0.0, \"balance_extra\" REAL NOT NULL DEFAULT 0.0, \"last_updated\" INTEGER NOT NULL, \"include_next_check\" INTEGER NOT NULL DEFAULT 0 CHECK (\"include_next_check\" IN (0, 1)), \"single_event_expiry_days\" INTEGER NOT NULL DEFAULT 30, \"tutorial_step\" INTEGER NOT NULL DEFAULT 0, \"tutorial_seen\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tutorial_seen\" IN (0, 1)), \"use_comma_separators\" INTEGER NOT NULL DEFAULT 0 CHECK (\"use_comma_separators\" IN (0, 1)), \"app_lock_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"app_lock_enabled\" IN (0, 1)), \"disclaimer_accepted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"disclaimer_accepted\" IN (0, 1)), \"last_bank_sync\" INTEGER NULL, \"pending_linked_balance_ids\" TEXT NOT NULL DEFAULT '', \"tasks_sync_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tasks_sync_enabled\" IN (0, 1)), \"tasks_list_id\" TEXT NULL, \"tasks_account\" TEXT NULL, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"accent_color\" TEXT NOT NULL DEFAULT 'blue', \"custom_accent\" INTEGER NOT NULL DEFAULT 4280908287, \"tasks_provider\" TEXT NOT NULL DEFAULT 'google', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "single_event_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"single_event_rows\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"amount\" REAL NOT NULL, \"is_debit\" INTEGER NOT NULL CHECK (\"is_debit\" IN (0, 1)), \"created_date\" INTEGER NOT NULL, \"last_modified_date\" INTEGER NOT NULL, \"applied_amount\" REAL NOT NULL, \"target\" TEXT NOT NULL, \"target_name\" TEXT NULL, \"target_id\" TEXT NULL);"
        }
      ]
    },
