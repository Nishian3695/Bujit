# Parameters for the tellerProxy function in project bujit-89ac6 (read by
# `firebase deploy`, so it doesn't prompt). Not secrets: the Plaid keys live in
# Secret Manager.
#   PLAID_ENV           sandbox | production (lowercase; anything else means sandbox)
#   PLAID_REDIRECT_URI  where Plaid sends iOS users back after a bank's own login;
#                       must be in the Plaid dashboard's allowed redirect URIs
PLAID_ENV=production
PLAID_REDIRECT_URI=https://bujit-89ac6.web.app/plaid-oauth
