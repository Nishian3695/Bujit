# Copy this file to keystore.properties (gitignored) and fill in your local values.
# keystore.properties is used by build.gradle to sign release builds locally.
# In CI, these values come from GitHub Secrets instead (see .github/workflows/release.yml).

storeFile=/absolute/path/to/your/release.jks
storePassword=your_store_password
keyAlias=your_key_alias
keyPassword=your_key_password
